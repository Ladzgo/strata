{
  "name": "Strata",
  "short_name": "Strata",
  "description": "Local-first notes, databases and whiteboards. Everything stays on your device.",
  "id": "./app/",
  "start_url": "./app/",
  "scope": "./app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14121a",
  "theme_color": "#14121a",
  "categories": ["productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Capture", "url": "./app/#capture", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
